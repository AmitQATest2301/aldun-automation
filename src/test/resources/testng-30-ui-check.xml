<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- The no-login part of the 30 cases (ALD001-ALD011) in one browser. Needs no account. -->
<suite name="Aldun 30 Test Cases - no-login part" verbose="1">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RunInIdOrder"/>
    </listeners>

    <test name="no-login cases">
        <classes>
            <class name="tests.cases.LoginScreenCases"/>
        </classes>
    </test>
</suite>
