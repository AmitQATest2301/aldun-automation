<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Create Interaction flow: log out if needed, log in, create an interaction, go to Today.
     One browser session. Runs on the LIVE app and creates a real interaction. -->
<suite name="Aldun Create Interaction Flow" verbose="1">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Create Interaction flow" preserve-order="true">
        <classes><class name="tests.CreateInteractionFlowTest"/></classes>
    </test>
</suite>
