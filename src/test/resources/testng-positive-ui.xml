<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Positive tests that never submit the login form (excludes the "auth" valid-login test) -->
<suite name="Aldun Positive Suite (no login)" verbose="1">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Login Module - Positive UI">
        <groups>
            <run>
                <include name="positive"/>
                <exclude name="auth"/>
            </run>
        </groups>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>
</suite>
